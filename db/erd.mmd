%% UNIQUE (jti);

%% -- 시험 코드 중복 방지
%% UNIQUE (code);

%% -- 시험 내 문항 번호 중복 방지
%% UNIQUE (exam_id, number);

%% -- 시험 내 문항 정렬 순서 중복 방지
